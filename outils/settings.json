{
	"replacerules.rules": {
		"removeCommentLines": {
			"find": "^#.*\\n",
			"replace": ""
		},
		"removeMulticharForLiveKeys": {
			"find": "^<[^>]+> * : .+\\n",
			"replace": ""
		},
		"removeKeypadEquivalents": {
			"find": ".+<KP_.+\\n",
			"replace": ""
		},
		"startAlignEndAligned": {
			"find": "^([^ ]+)( *)([^ ]+)( *: .*)$",
			"replace": "$1$3$2$4"
		},
		"startAlignMixedAligned": {
			"find": "^([^ ]+)( +)([^ ]+)( +)([^ ]+)( *: .*)$",
			"replace": "$1$3$5$2$4$6"
		},
		"decodeGroup": {
			"find": "<UEFD0",
			"replace": "<dead_group"
		},
		"decodeSuperscript": {
			"find": "<UEFD1",
			"replace": "<dead_superscript"
		},
		"decodeSubscript": {
			"find": "<UEFD2",
			"replace": "<dead_subscript"
		},
		"decodeAbovehook": {
			"find": "<UEFD3",
			"replace": "<dead_abovehook"
		},
		"decodeRetroflexhook": {
			"find": "<UEFD4",
			"replace": "<dead_retroflexhook"
		},
		"decodeTurned": {
			"find": "<UEFD5",
			"replace": "<dead_turned"
		},
		"decodeReversed": {
			"find": "<UEFD6",
			"replace": "<dead_reversed"
		},
		"decodeFlag": {
			"find": "<UEFD7",
			"replace": "<dead_flag"
		},
		"decodeBar": {
			"find": "<UEFD8",
			"replace": "<dead_bar"
		},
		"decodeLegacyTilde": {
			"find": "<UEFD9",
			"replace": "<dead_legacytilde"
		},
		"decodeLegacyGrave": {
			"find": "<UEFDA",
			"replace": "<dead_legacygrave"
		},
		"prefixDeadKeySyms": {
			"find": "<dead_",
			"replace": "<!dead_"
		},
		"syncMultikey": {
			"find": "<Multi_key",
			"replace": "<!Multikey"
		},
		"decodeCapitalOpenE": {
			"find": "<U0190",
			"replace": "<Eopen"
		},
		"decodeSmallOpenE": {
			"find": "<U025B",
			"replace": "<eopen"
		},
		"decodeCapitalOpenO": {
			"find": "<U0186",
			"replace": "<Oopen"
		},
		"decodeSmallOpenO": {
			"find": "<U0254",
			"replace": "<oopen"
		},
		"sortEuroSign": {
			"find": "<(EuroSign)",
			"replace": "<quot$1"
		},
		"sortSectionSign": {
			"find": "<(section)",
			"replace": "<exc$1"
		},
		"sortRightSingleQuotationMark": {
			"find": "<rightsinglequotemark",
			"replace": "<aprightsingquotmark"
		},
		"prefixAsciiAndAliases": {
			"find": "<(ampersand|apostrophe|aprightsingquotmark|asciicircum|asciitilde|asterisk|at|backslash|bar|braceleft|braceright|bracketleft|bracketright|colon|comma|dollar|equal|exclam|grave|greater|less|minus|numbersign|parenleft|parenright|percent|period|plus|question|quotEuroSign|quotedbl|semicolon|excsection|slash|underscore)>",
			"replace": "<%$1>"
		},
		"sortSpaces": {
			"find": "<((nobreak)?space)",
			"replace": "<~$1"
		},
		"decodeNoBreakThinSpace": {
			"find": "<U202F",
			"replace": "<~nobreakthinspace"
		},
		"decodeZeroWidthSpace": {
			"find": "<U200B",
			"replace": "<~spacezerowidth"
		},
		"collapsePaddingSpaces": {
			"find": ">\\s*:",
			"replace": "> :"
		},
		"permutate2": {
			"find": "^(<[^<>]+>)(<[^<>]+>)( .+)",
			"replace": "@$1$2$3\n@$2$1$3"
		},
		"permutate2SameAnd1": {
			"find": "^(<[^<>]+>)\\1(<[^<>]+>)( .+)",
			"replace": "@$1$1$2$3\n@$1$2$1$3\n@$2$1$1$3"
		},
		"permutate1And2Same": {
			"find": "^(<[^<>]+>)(<[^<>]+>)\\2( .+)",
			"replace": "@$1$2$2$3\n@$2$1$2$3\n@$2$2$1$3"
		},
		"permutate3": {
			"find": "^(<[^<>]+>)(<[^<>]+>)(<[^<>]+>)( .+)",
			"replace": "@$1$2$3$4\n@$1$3$2$4\n@$2$1$3$4\n@$3$1$2$4\n@$2$3$1$4\n@$3$2$1$4"
		},
		"permutate2SameAnd2Same": {
			"find": "^(<[^<>]+>)\\1(<[^<>]+>)\\2( .+)",
			"replace": "@$1$1$2$2$3\n@$1$2$1$2$3\n@$2$1$2$1$3\n@$2$2$1$1$3"
		},
		"permutate2SameAnd2": {
			"find": "^(<[^<>]+>)\\1(<[^<>]+>)(<[^<>]+>)( .+)",
			"replace": "@$1$1$2$3$4\n@$1$1$3$2$4\n@$1$2$1$3$4\n@$1$2$3$1$4\n@$1$3$1$2$4\n@$1$3$2$1$4\n@$2$1$1$3$4\n@$2$1$3$1$4\n@$2$3$1$1$4\n@$3$1$1$2$4\n@$3$1$2$1$4\n@$3$2$1$1$4"
		},
		"permutate1And2SameAnd1": {
			"find": "^(<[^<>]+>)(<[^<>]+>)\\2(<[^<>]+>)( .+)",
			"replace": "@$1$2$2$3$4\n@$1$2$3$2$4\n@$1$3$2$2$4\n@$2$1$2$3$4\n@$2$1$3$2$4\n@$2$2$1$3$4\n@$2$2$3$1$4\n@$2$3$1$2$4\n@$2$3$2$1$4\n@$3$1$2$2$4\n@$3$2$1$2$4\n@$3$2$2$1$4"
		},
		"permutate2And2Same": {
			"find": "^(<[^<>]+>)(<[^<>]+>)(<[^<>]+>)\\3( .+)",
			"replace": "@$1$2$3$3$4\n@$1$3$2$3$4\n@$1$3$3$2$4\n@$2$1$3$3$4\n@$2$3$1$3$4\n@$2$3$3$1$4\n@$3$1$2$3$4\n@$3$1$3$2$4\n@$3$2$1$3$4\n@$3$2$3$1$4\n@$3$3$1$2$4\n@$3$3$2$1$4"
		},
		"permutate4": {
			"find": "^(<[^<>]+>)(<[^<>]+>)(<[^<>]+>)(<[^<>]+>)( .+)",
			"replace": "@$1$2$3$4$5\n@$1$2$4$3$5\n@$1$3$2$4$5\n@$1$4$2$3$5\n@$1$3$4$2$5\n@$1$4$3$2$5\n@$2$1$3$4$5\n@$2$1$4$3$5\n@$3$1$2$4$5\n@$4$1$2$3$5\n@$3$1$4$2$5\n@$4$1$3$2$5\n@$2$3$1$4$5\n@$2$4$1$3$5\n@$3$2$1$4$5\n@$4$2$1$3$5\n@$3$4$1$2$5\n@$4$3$1$2$5\n@$2$3$4$1$5\n@$2$4$3$1$5\n@$3$2$4$1$5\n@$4$2$3$1$5\n@$3$4$2$1$5\n@$4$3$2$1$5"
		},
		"formatChangelogRule": {
			"find": "U([0-9A-F]{4,5})",
			"replace": "U+$1"
		},
		"unformatChangelogRule": {
			"find": "U\\+([0-9A-F]{4,5})",
			"replace": "U$1"
		}
	},
	"replacerules.rulesets": {
		"symmetrizeChainedDeadKeys": {
			"rules": [
				"permutate2",
				"permutate2SameAnd1",
				"permutate1And2Same",
				"permutate3",
				"permutate2SameAnd2Same",
				"permutate2SameAnd2",
				"permutate1And2SameAnd1",
				"permutate2And2Same",
				"permutate4"
			]
		},
		"prepareXComposeForCheck": {
			"rules": [
				"removeCommentLines",
				"removeMulticharForLiveKeys",
				"removeKeypadEquivalents",
				"startAlignEndAligned",
				"startAlignMixedAligned"
			]
		},
		"improveXComposeSortability": {
			"rules": [
				"decodeGroup",
				"decodeSuperscript",
				"decodeSubscript",
				"decodeAbovehook",
				"decodeRetroflexhook",
				"decodeTurned",
				"decodeReversed",
				"decodeFlag",
				"decodeBar",
				"decodeLegacyTilde",
				"decodeLegacyGrave",
				"prefixDeadKeySyms",
				"syncMultikey",
				"decodeCapitalOpenE",
				"decodeSmallOpenE",
				"decodeCapitalOpenO",
				"decodeSmallOpenO",
				"sortEuroSign",
				"sortSectionSign",
				"sortAtSign",
				"sortRightSingleQuotationMark",
				"prefixAsciiAndAliases",
				"sortSpaces",
				"decodeNoBreakThinSpace",
				"decodeZeroWidthSpace",
				"collapsePaddingSpaces"
			]
		},
		"unformatChangelog": {
			"rules": [
				"unformatChangelogRule"
			]
		},
		"formatChangelog": {
			"rules": [
				"formatChangelogRule"
			]
		}
	}
}
